# Copiá este archivo a .env (con `cp`, no lo renombres) y completá los valores reales.
# El .env NUNCA se sube a git; este .env.example sí (sin secretos).

# Puerto en el que escucha la API
PORT=3000

# Base de desarrollo: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://kanban_app:CAMBIAR_CONTRASEÑA@localhost:5432/kanban_app

# Base de tests (se vacía en cada test: nunca apuntarla a la de desarrollo)
TEST_DATABASE_URL=postgres://kanban_app:CAMBIAR_CONTRASEÑA@localhost:5432/kanban_app_test

# Secreto con el que se firman los JWT. Generá uno con: openssl rand -hex 32
# Distinto en cada entorno (desarrollo, producción): quien lo conoce puede fabricar tokens.
JWT_SECRET=CAMBIAR_SECRETO
