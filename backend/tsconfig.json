{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src", "test", "drizzle.config.ts", "vitest.config.ts"]
}
