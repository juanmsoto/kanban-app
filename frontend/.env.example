# Copiá este archivo a .env (con `cp`) y ajustá si hace falta. El .env no se sube a git.
# Vite solo expone al navegador las variables que empiezan con VITE_, y TODO lo que
# lleve ese prefijo termina visible en el código que descarga cualquier usuario:
# nunca pongas acá secretos, contraseñas ni claves.

# Dirección base de la API (sin barra final)
VITE_API_URL=http://localhost:3000
